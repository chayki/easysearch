<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <NameOfLastUsedPublishProfile>CustomProfile</NameOfLastUsedPublishProfile>
    <GoogleCloudPublishConfiguration>Release</GoogleCloudPublishConfiguration>
    <GoogleKubernetesEnginePublishDeploymentName>easy-search</GoogleKubernetesEnginePublishDeploymentName>
    <GoogleKubernetesEnginePublishVersion>20190210t150828</GoogleKubernetesEnginePublishVersion>
    <GoogleKubernetesEnginePublishReplicas>3</GoogleKubernetesEnginePublishReplicas>
    <GoogleKubernetesEnginePublishExposeService>False</GoogleKubernetesEnginePublishExposeService>
    <GoogleKubernetesEnginePublishExposePublicService>False</GoogleKubernetesEnginePublishExposePublicService>
    <GoogleKubernetesEnginePublishOpenWebsite>False</GoogleKubernetesEnginePublishOpenWebsite>
    <GoogleComputeEnginePublishOpenWebsite>False</GoogleComputeEnginePublishOpenWebsite>
    <GoogleComputeEnginePublishLaunchRemoteDebugger>False</GoogleComputeEnginePublishLaunchRemoteDebugger>
    <GoogleComputeEnginePublishSiteName>Default Web Site</GoogleComputeEnginePublishSiteName>
    <ShowAllFiles>true</ShowAllFiles>
    <GoogleCloudPublishChoice>Gce</GoogleCloudPublishChoice>
    <GoogleComputeEnginePublishInstanceName>aspnet-easysearch</GoogleComputeEnginePublishInstanceName>
    <GoogleComputeEnginePublishInstanceZone>asia-south1-a</GoogleComputeEnginePublishInstanceZone>
    <GoogleComputeEnginePublishInstanceUserName>easysearch</GoogleComputeEnginePublishInstanceUserName>
  </PropertyGroup>
</Project>